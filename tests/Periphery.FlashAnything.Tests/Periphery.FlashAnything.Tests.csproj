<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Opted out of the wall-clock ratchet in tests/Directory.Build.targets (ADR-0089).
      Temporary, tracked in #244; comes off when the last violation is gone.
      Fifteen negative assertions follow a fixed Task.Delay, and the probe and flash
      doubles widen their calls with real delays. FlashAnythingService exposes no signal
      that its flash queue is idle.
    -->
    <PeripheryBanWallClockInTests>false</PeripheryBanWallClockInTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Periphery" />
    <Using Include="Periphery.Bootloader" />
    <Using Include="Periphery.Firmware" />
    <Using Include="Periphery.FlashAnything" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Periphery\Periphery.csproj" />
    <ProjectReference Include="..\..\src\Periphery.Firmware\Periphery.Firmware.csproj" />
    <ProjectReference Include="..\..\src\Periphery.Bootloader\Periphery.Bootloader.csproj" />
    <ProjectReference Include="..\..\src\Periphery.FlashAnything\Periphery.FlashAnything.csproj" />
  </ItemGroup>

</Project>
