<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Opted out of the wall-clock ratchet in tests/Directory.Build.targets (ADR-0089).
      Temporary, tracked in #244; comes off when the last violation is gone.
      LinuxUsbIntegrationTests bounds a cancel and a dispose with a Stopwatch. Converting
      them needs a run on the Linux device rig, which is a separate change.
    -->
    <PeripheryBanWallClockInTests>false</PeripheryBanWallClockInTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Periphery" />
    <Using Include="Periphery.Usb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Periphery\Periphery.csproj" />
    <ProjectReference Include="..\..\src\Periphery.Usb\Periphery.Usb.csproj" />
  </ItemGroup>

</Project>
