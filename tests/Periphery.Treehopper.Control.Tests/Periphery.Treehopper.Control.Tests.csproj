<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Opted out of the wall-clock ratchet in tests/Directory.Build.targets (ADR-0089).
      Temporary, tracked in #244; comes off when the last violation is gone.
      HotplugEdgeBindingTests polls on DateTime.UtcNow and settles with fixed delays before
      negative assertions. TreehopperControlService exposes no drain signal.
    -->
    <PeripheryBanWallClockInTests>false</PeripheryBanWallClockInTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Periphery.Treehopper" />
    <Using Include="Periphery.Treehopper.Control" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Periphery.Treehopper\Periphery.Treehopper.csproj" />
    <ProjectReference Include="..\..\src\Periphery.Treehopper.Control\Periphery.Treehopper.Control.csproj" />
  </ItemGroup>

</Project>
