<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Pairs and unpairs a BLE bench peripheral from code, so the re-pair cells of
         issue #232 need no one at Windows Settings. Pairing is Just Works, accepted
         through DeviceInformationCustomPairing with DevicePairingKinds.ConfirmOnly. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
