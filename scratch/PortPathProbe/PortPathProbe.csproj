<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Periphery supplies both the *resolved* LocationPath under test and the
         PortPath that parses it (ADR-0079 D4). The other side of the comparison is
         not taken from it: the ground-truth walk in CfgMgr.cs is an independent
         cfgmgr32 P/Invoke, precisely so the comparison is not the library checking
         itself. -->
    <ProjectReference Include="..\..\src\Periphery\Periphery.csproj" />
  </ItemGroup>

</Project>
