<!--
  Microsoft.NET.Sdk.Razor, not Microsoft.NET.Sdk: the Razor SDK packs wwwroot/ as a static web
  asset served at _content/Periphery.Serial.Browser/, where the JS module loads from (ADR-0092 D3).
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- net10.0 with the browser platform declared, as Periphery.Usb.Browser (ADR-0092 D3). -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The [JSImport] source generator emits unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>Periphery.Serial.Browser</PackageId>
    <Description>Web Serial for Periphery in a browser. Opens the serial port the user picked through the browser's chooser and exposes it as an IDuplexPipe, with DTR and RTS control for bootloader entry. Takes no dependency on System.IO.Ports.</Description>
    <PackageTags>hardware;serial;web-serial;browser;wasm;blazor;pipelines;periphery</PackageTags>

    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!--
    No reference to Periphery or Periphery.Serial (ADR-0092 D2). A page that flashes over Web Serial
    takes neither Periphery.Usb nor System.IO.Ports. System.IO.Pipelines needs no package reference:
    it ships in the net10.0 shared framework, and the SDK flags a reference to it with NU1510.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.103" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Periphery.Serial.Browser.Tests" />
  </ItemGroup>

  <!-- Nothing in this package blocks on a task (ADR-0092 D8). -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="All" />
    <AdditionalFiles Include="..\BannedSymbols.Browser.txt" />
  </ItemGroup>

</Project>
