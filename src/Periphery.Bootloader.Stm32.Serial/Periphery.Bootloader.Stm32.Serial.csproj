<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- XML Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;SYSLIB1051</NoWarn>

    <!-- Package Metadata -->
    <!-- Packable as of the Datafeel dot flasher, which lives in its own repo and needs the AN3155
         programmer from a feed rather than a project reference. It held IsPackable=false while
         ADR-0061 phase 3 was in progress, matching the .Usb sibling, which stays unpackable until
         something outside this repo needs it too. The contract this publishes is the one the
         Treehopper and FlashAnything compositions have been building against for several
         releases, and periphery#169 verified it against a live STM32G431. -->
    <PackageId>Periphery.Bootloader.Stm32.Serial</PackageId>
    <Description>STM32 UART bootloader flasher (ST AN3155): a pure planner, an AN3155 shell over the CallAndResponse Stm32BootloaderClient, and an IFirmwareProgrammer / IBootloaderProvider adapter. Drives the system bootloader over a serial port - sync, extended erase, write, read-back verify, and Go - on a part already in system-bootloader mode. ADR-0061.</Description>
    <PackageTags>hardware;serial;uart;stm32;an3155;bootloader;firmware;periphery</PackageTags>

    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>

    <!-- ADR-0061 DEC-006, fulfilled: OpenAsync builds its port and pipe over Periphery.Serial
         (System.IO.Ports, zero third-party dep) rather than CallAndResponse.Transport.Serial,
         which was the only RJCP-pulling package this flasher touched. The ADR-0062 amendment's
         measurement is the other half of the reason - identical AN3155 round trips ran 3x
         faster over the BCL backend than over RJCP, so this is also the faster default for the
         flashing workload, not just the leaner one.

         AOT survives it, which was not obvious: IsAotCompatible is claimed below, and
         `dotnet publish -p:PublishAot=true` of Periphery.FlashAnything.Cli - which references
         this package - links with zero IL trim warnings. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Periphery\Periphery.csproj" />
    <ProjectReference Include="..\Periphery.Firmware\Periphery.Firmware.csproj" />
    <ProjectReference Include="..\Periphery.Bootloader\Periphery.Bootloader.csproj" />
    <ProjectReference Include="..\Periphery.Serial\Periphery.Serial.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CallAndResponse" Version="2.0.0-alpha.7" />
    <PackageReference Include="CallAndResponse.Protocol.Stm32Bootloader" Version="2.0.0-alpha.7" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Periphery.Bootloader.Stm32.Serial.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.103" PrivateAssets="All" />
  </ItemGroup>

</Project>
