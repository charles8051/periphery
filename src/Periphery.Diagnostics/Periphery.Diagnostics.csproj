<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>

    <!-- Shared host-side logging scaffolding: one ILoggerProvider that mirrors Periphery's DEBUG
         trace to a file (the GUI/example log-file flag) or stderr (the CLI verbose flag), behind
         an ILogSink so the sink is the only thing a host picks. App scaffolding that sits behind
         the PeripheryLoggerFactory seam, not library surface — hence IsPackable=false, so it never
         lands in the local NuGet feed. Abstractions-only, so it stays AOT-clean for the
         self-contained GUI publish. Replaces the three near-identical hand-rolled copies flagged
         in docs/explorations/architecture-deepening-review-2026-06 (section 6.4). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
