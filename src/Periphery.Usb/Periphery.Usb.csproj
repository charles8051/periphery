<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- XML Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;SYSLIB1051</NoWarn>

    <!-- Package Metadata -->
    <PackageId>Periphery.Usb</PackageId>
    <Description>Raw USB I/O extension for Periphery. Provides UsbDevice (one-shot open) and UsbDeviceProxy (reconnect-resilient) for claiming interfaces and running control / bulk transfers, on Windows via a native WinUSB backend and on Linux via libusb-1.0. (The macOS backend is planned — ADR-0038.)</Description>
    <PackageTags>hardware;usb;winusb;device;cross-platform;periphery</PackageTags>

    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Periphery\Periphery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Periphery.Usb.Tests" />
    <InternalsVisibleTo Include="Periphery.Treehopper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Abstractions-only logging dependency (never a provider). Referenced directly —
         not just transitively via Periphery — so the [LoggerMessage] source generator
         (an analyzer, which does not flow through a ProjectReference) runs here. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.103" PrivateAssets="All" />
  </ItemGroup>

</Project>
