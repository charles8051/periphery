<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- XML Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;SYSLIB1051</NoWarn>

    <!-- Package Metadata -->
    <PackageId>Periphery.Monitor</PackageId>
    <Description>Monitor-control extension for Periphery (ADR-0058). Provides MonitorDevice (one-shot open) and MonitorDeviceProxy (reconnect-resilient) over two independent planes: DDC/CI VCP control (brightness, contrast, input source, power — dxva2 on Windows, /dev/i2c DDC on Linux) and display-mode control (resolution, orientation, refresh — ChangeDisplaySettingsEx on Windows; Linux deferred).</Description>
    <PackageTags>hardware;monitor;display;ddc;ddcci;mccs;vcp;brightness;resolution;orientation;periphery</PackageTags>

    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Periphery\Periphery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Periphery.Monitor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.103" PrivateAssets="All" />
  </ItemGroup>

</Project>
