<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- XML Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;SYSLIB1051</NoWarn>

    <!-- Package Metadata -->
    <PackageId>Periphery.Treehopper.Control</PackageId>
    <Description>Pure MVU core and (later) app service for the Treehopper control app: an immutable AppState folded from AppEvents by a pure reducer, rendered by interchangeable CLI and Avalonia front-ends. Phase 1: pure core only.</Description>
    <PackageTags>treehopper;mvu;control;periphery</PackageTags>

    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure core needs only Periphery.Treehopper's value types; the app service
         (TreehopperControlService) adds device discovery, USB version reads, and the
         firmware-reflash substrate (TreehopperFirmwareUpdate, now in Periphery.Treehopper.Firmware). -->
    <ProjectReference Include="..\Periphery\Periphery.csproj" />
    <ProjectReference Include="..\Periphery.Usb\Periphery.Usb.csproj" />
    <ProjectReference Include="..\Periphery.Treehopper\Periphery.Treehopper.csproj" />
    <ProjectReference Include="..\Periphery.Treehopper.Firmware\Periphery.Treehopper.Firmware.csproj" />
    <ProjectReference Include="..\Periphery.Bootloader.Efm8.Usb\Periphery.Bootloader.Efm8.Usb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Periphery.Treehopper.Control.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.103" PrivateAssets="All" />
  </ItemGroup>

</Project>
