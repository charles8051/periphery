<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Periphery.FlashAnything.Gui.ViewModels"
        x:Class="Periphery.FlashAnything.Gui.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="660" Height="460"
        Title="FlashAnything">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="FlashAnything" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusLine}" Opacity="0.7" Margin="0,0,0,10" />

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <Button Content="Pick firmware..." Click="OnPickFirmware" />
      <TextBlock Text="{Binding FirmwareSummary}" VerticalAlignment="Center" Opacity="0.85" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Autoflash:" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}" MinWidth="150" />
      <Button Content="Arm" Command="{Binding ArmCommand}" />
      <Button Content="Disarm" Command="{Binding DisarmCommand}" />
      <TextBlock Text="{Binding AutoflashStatus}" VerticalAlignment="Center" Opacity="0.85" />
    </StackPanel>

    <ListBox ItemsSource="{Binding Targets}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TargetRow">
          <TextBlock Text="{Binding Summary}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
