<!--
  A Blazor WebAssembly page that runs ADR-0092's verification gates by hand, in a Chromium-based
  browser with the devices on the bench. Run it with `dotnet run` and open it in Chrome or Edge; an
  embedded browser without a device chooser cannot grant a device.
-->
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Periphery.Examples.Browser</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Periphery\Periphery.csproj" />
    <ProjectReference Include="..\..\src\Periphery.Usb\Periphery.Usb.csproj" />
    <ProjectReference Include="..\..\src\Periphery.Usb.Browser\Periphery.Usb.Browser.csproj" />
    <ProjectReference Include="..\..\src\Periphery.Serial.Browser\Periphery.Serial.Browser.csproj" />
    <ProjectReference Include="..\..\src\Periphery.Treehopper\Periphery.Treehopper.csproj" />
    <ProjectReference Include="..\..\src\Periphery.Bootloader.Stm32.Usb\Periphery.Bootloader.Stm32.Usb.csproj" />
    <ProjectReference Include="..\..\src\Periphery.Bootloader.Stm32.Serial\Periphery.Bootloader.Stm32.Serial.csproj" />
  </ItemGroup>

</Project>
